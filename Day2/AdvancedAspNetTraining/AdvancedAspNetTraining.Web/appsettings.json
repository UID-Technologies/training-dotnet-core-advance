{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AdvancedAspNetTraining",
    "Audience": "AdvancedAspNetTraining.Clients",
    "SigningKey": "TrainingSigningKey_ChangeInProduction_Min32Chars!",
    "ExpirationMinutes": 60
  },
  "Training": {
    "EnvironmentName": "Production",
    "ApiBasePath": "/api"
  }
}
